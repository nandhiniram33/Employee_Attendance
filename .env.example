# Database Configuration (Docker MySQL host port 3307 or native MySQL 3306)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/employee_attendance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=apppass

# Server & Security
SERVER_PORT=8080
JWT_SECRET=employeeAttendanceSystemSecretKeyForJwtAuthentication2026
JWT_EXPIRATION=86400000

# Service URLs & CORS
AI_SERVICE_URL=http://localhost:5001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_SERVICE_URL=http://localhost:5001
